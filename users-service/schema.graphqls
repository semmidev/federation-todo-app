scalar Time

"""
User is owned by this subgraph (users-service). todos-service extends this
entity with a `todos` field without ever writing to the users table.
"""
type User @key(fields: "id") {
  id: ID!
  username: String!
  email: String!
  fullName: String!
  createdAt: Time!
  updatedAt: Time!
}

input NewUserInput {
  username: String!
  email: String!
  fullName: String!
}

input UpdateUserInput {
  username: String
  email: String
  fullName: String
}

type Query {
  user(id: ID!): User
  users(limit: Int = 20, offset: Int = 0): [User!]!
}

type Mutation {
  createUser(input: NewUserInput!): User!
  updateUser(id: ID!, input: UpdateUserInput!): User!
  deleteUser(id: ID!): Boolean!
}
